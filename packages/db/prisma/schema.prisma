generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Jurisdiction {
  MEXICO
  SWITZERLAND
}

enum LegalLevel {
  FEDERAL
  STATE
  CANTONAL
}

enum OutputLanguage {
  EN
  ES
  FR
}

model Project {
  id          String        @id @default(uuid())
  name        String
  description String?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  analyses    AnalysisRun[]
}

model AnalysisRun {
  id             String         @id @default(uuid())
  projectId      String?
  project        Project?       @relation(fields: [projectId], references: [id])
  canonicalDocumentId String?
  canonicalDocument CanonicalDocument? @relation("DocumentRuns", fields: [canonicalDocumentId], references: [id])
  jurisdiction   Jurisdiction
  legalLevel     LegalLevel?
  outputLanguage OutputLanguage
  status         String
  isCurrent      Boolean        @default(false)
  isPubliclyVisible Boolean     @default(true)
  triggerType    String?
  inputMetadata  Json?
  analysisOutput Json?
  errorLog       String?
  processingTimeMs Int?
  modelVersion   String?
  promptVersion  String?
  createdByUserId String?
  createdBySessionId String?
  deletedAt      DateTime?
  adminNotes     String?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  sourceDocument     SourceDocument?
  dashboardSummaries DashboardSummary[]
  heatmapRecords     HeatmapRecord[]
  findingCards       StructuredFindingCard[]
  currentForDocuments CanonicalDocument[] @relation("CurrentRun")
  usageEvents UsageEvent[]
}

model CanonicalDocument {
  id                   String       @id @default(uuid())
  country              String?
  subnationalUnit      String?
  jurisdiction         Jurisdiction
  legalLevel           LegalLevel?
  documentType         String?
  titleOriginal        String?
  titleNormalized      String
  lawDate              String?
  publicationDate      String?
  sourceUrl            String?
  documentHash         String?
  language             OutputLanguage
  isPublic             Boolean      @default(true)
  currentAnalysisRunId String?
  currentAnalysisRun   AnalysisRun? @relation("CurrentRun", fields: [currentAnalysisRunId], references: [id])
  runs                 AnalysisRun[] @relation("DocumentRuns")
  usageEvents          UsageEvent[]
  createdAt            DateTime     @default(now())
  updatedAt            DateTime     @updatedAt

  @@index([jurisdiction, titleNormalized, lawDate])
}

model UsageEvent {
  id                  String            @id @default(uuid())
  userId              String?
  sessionId           String?
  canonicalDocumentId String?
  canonicalDocument   CanonicalDocument? @relation(fields: [canonicalDocumentId], references: [id])
  analysisRunId       String?
  analysisRun         AnalysisRun?      @relation(fields: [analysisRunId], references: [id])
  eventType           String
  countryHint         String?
  ipHash              String?
  userAgent           String?
  createdAt           DateTime          @default(now())

  @@index([eventType, createdAt])
}

model SourceDocument {
  id                 String      @id @default(uuid())
  analysisRunId      String      @unique
  analysisRun        AnalysisRun @relation(fields: [analysisRunId], references: [id])
  sourceType         String      // TEXT, PDF
  content            String?
  metadata           Json?
  versionDate        String?
  completenessStatus String?
}

model DashboardSummary {
  id                    String      @id @default(uuid())
  analysisRunId         String
  analysisRun           AnalysisRun @relation(fields: [analysisRunId], references: [id])
  dimension             String      // e.g., "Normative coverage", "Institutional anchoring"
  value                 String?     // Score or descriptive value
  explanation           String?
}

model HeatmapRecord {
  id                 String      @id @default(uuid())
  analysisRunId      String
  analysisRun        AnalysisRun @relation(fields: [analysisRunId], references: [id])
  domesticProvision  String?
  crpdArticle        String?
  alignmentType      String?     // e.g., "Strong anchoring", "Partial anchoring", "Normative silence"
  evidenceExcerpt    String?
  analyticalNote     String?
}

model StructuredFindingCard {
  id               String      @id @default(uuid())
  analysisRunId    String
  analysisRun      AnalysisRun @relation(fields: [analysisRunId], references: [id])
  title            String
  category         String?     // e.g., "omission", "ambiguity", "weak enforceability"
  significance     String?     // why it matters for implementation
  legalExcerpt     String?
  standardEngaged  String?     // linked standard / CRPD reference
}
