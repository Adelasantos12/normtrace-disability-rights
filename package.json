{
  "name": "normtrace",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "postinstall": "cd packages/db && npx prisma generate",
    "build": "npm run build --workspaces --if-present",
    "build:api": "npm run build -w @normtrace/i18n -w @normtrace/api --if-present",
    "build:web": "npm run build -w @normtrace/ui -w @normtrace/i18n -w @normtrace/web --if-present",
    "dev": "npm run build --workspaces --if-present && npm run dev --workspaces --if-present"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.2.2",
    "jiti": "^2.6.1"
  }
}
